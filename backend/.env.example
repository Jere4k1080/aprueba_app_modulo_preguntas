# Entorno y Servidor
PORT=4000
NODE_ENV=development

# Configuración de Cuota (Decisión ADR-11)
QUOTA_RESET_HOUR_LOCAL=0
QUOTA_RESET_TIMEZONE=America/Santiago

# Autenticación JWT (Clave secreta para desarrollo)
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Firestore / Firebase
# Para emulador local, descomentar la siguiente línea:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=aprueba-dev

# Credenciales de producción (Ruta a archivo de servicio, NUNCA versionar el JSON real)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
