# Entorno y Servidor
PORT=4000
# local | staging | production
APP_ENV=local

# Configuración de Cuota (Decisión ADR-11)
QUOTA_RESET_HOUR_LOCAL=0
QUOTA_RESET_TIMEZONE=America/Santiago

# Firestore y verificación de tokens de Firebase Auth (misma cuenta de servicio)
# Emulador local; no configurar en Vercel:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Proyecto de Firestore dentro del emulador, el mismo con que se levanta. Con demo- nunca toca
# recursos reales (ADR-49).
FIRESTORE_EMULATOR_PROJECT_ID=demo-aprueba
# Solo para validar tokens de Firebase Auth: es la audiencia (aud) que exige verify_id_token, así que
# va el proyecto donde la app inicia sesión (ADR-49).
FIREBASE_PROJECT_ID=aprueba-app-modulo-preguntas
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Orígenes web permitidos (lista exacta y patrón opcional para vistas previas)
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_PATTERN=

# Exige confirmación explícita para cargar datos de prueba en Firestore real
SEED_ALLOW_REMOTE=false

# En Vercel define APP_ENV=production, no definas FIRESTORE_EMULATOR_HOST y configura FIREBASE_SERVICE_ACCOUNT_BASE64.
