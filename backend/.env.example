# Entorno y Servidor
PORT=4000
NODE_ENV=development

# Configuración de Cuota (Decisión ADR-11)
QUOTA_RESET_HOUR_LOCAL=0
QUOTA_RESET_TIMEZONE=America/Santiago

# Autenticación JWT (obligatoria en producción)
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Firestore / Firebase
# Emulador local; no configurar en Vercel:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=aprueba-dev
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Orígenes web permitidos (lista exacta y patrón opcional para vistas previas)
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_PATTERN=

# Exige confirmación explícita para cargar datos de prueba en Firestore real
SEED_ALLOW_REMOTE=false

# En Vercel no definas FIRESTORE_EMULATOR_HOST y configura FIREBASE_SERVICE_ACCOUNT_BASE64.
