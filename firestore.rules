rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Catálogo: pruebas PAES (solo lectura pública) ────────────────────────
    match /tests/{testId} {
      allow read: if true;
      allow write: if false; // Solo admin / seed
    }

    // ── Habilidades (solo lectura pública) ───────────────────────────────────
    match /skills/{skillId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Banco de preguntas (lectura autenticada) ─────────────────────────────
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Solo admin / seed
    }

    // ── Datos del usuario ────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Respuestas: el alumno crea, nadie modifica ni borra.
      match /answers/{answerId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.keys()
                           .hasAll(['questionId', 'selected', 'correct', 'elapsedMs', 'answeredAt'])
                      && request.resource.data.questionId is string
                      && request.resource.data.selected is string
                      && request.resource.data.correct is bool
                      && request.resource.data.elapsedMs is int;
        allow update, delete: if false;
      }

      // Recorrecciones: el alumno crea, nadie modifica ni borra desde el cliente.
      match /corrections/{correctionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.keys()
                           .hasAll(['questionId', 'reason', 'status'])
                      && request.resource.data.questionId is string
                      && request.resource.data.reason is string
                      && request.resource.data.status == 'pending';
        allow update, delete: if false;
      }

      // Ledger de medallas: solo el backend escribe.
      match /medalLedger/{entryId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}

